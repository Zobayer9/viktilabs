{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

{% liquid
  assign social_links = ''
  if section.settings.social_facebook != blank
    assign social_links = social_links | append: 'facebook,'
  endif
  if section.settings.social_instagram != blank
    assign social_links = social_links | append: 'instagram,'
  endif
  if section.settings.social_whatsapp != blank
    assign social_links = social_links | append: 'whatsapp,'
  endif
  if section.settings.social_x != blank
    assign social_links = social_links | append: 'x,'
  endif
  if section.settings.social_tiktok != blank
    assign social_links = social_links | append: 'tiktok,'
  endif
  if section.settings.social_youtube != blank
    assign social_links = social_links | append: 'youtube,'
  endif
%}

<style>
  #shopify-section-{{ section.id }} .site-footer{
    --sf-columns-desktop: {{ section.settings.columns_desktop }};
    --sf-columns-mobile: {{ section.settings.columns_mobile }};
    --sf-link-hover: {{ section.settings.link_hover_color }};
    --sf-accent: {{ section.settings.accent_color }};
    --sf-accent-text: {{ section.settings.accent_text_color }};
    --sf-border-color: {{ section.settings.border_color }};
    --sf-bg: {{ section.settings.bg_color }};
    --sf-text: {{ section.settings.text_color }};
    --sf-heading: {{ section.settings.heading_color }};
    --sf-link: {{ section.settings.link_color }};
    --sf-copyright-size: {{ section.settings.copyright_font_size }}px;

    /* Mobile */
    --sf-pt: {{ section.settings.padding_top_mobile }}px;
    --sf-pb: {{ section.settings.padding_bottom_mobile }}px;
    --sf-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --sf-text-size: {{ section.settings.text_font_size_mobile }}px;
    --sf-link-size: {{ section.settings.menu_link_font_size}}px;
    --sf-grid-gap: {{ section.settings.grid_gap_mobile }}px;

    /* Tablet */
    --sf-pt-tab: {{ section.settings.padding_top_tablet }}px;
    --sf-pb-tab: {{ section.settings.padding_bottom_tablet }}px;
    --sf-heading-size-tab: {{ section.settings.heading_font_size_tablet }}px;
    --sf-text-size-tab: {{ section.settings.text_font_size_tablet }}px;
    --sf-grid-gap-tab: {{ section.settings.grid_gap_tablet }}px;

    /* Desktop */
    --sf-pt-desk: {{ section.settings.padding_top_desktop }}px;
    --sf-pb-desk: {{ section.settings.padding_bottom_desktop }}px;
    --sf-heading-size-desk: {{ section.settings.heading_font_size_desktop }}px;
    --sf-text-size-desk: {{ section.settings.text_font_size_desktop }}px;
    --sf-link-size-desk: {{ section.settings.menu_link_font_size_desktop }}px;
    --sf-copyright-size-desk: {{ section.settings.copyright_font_size_desktop }}px;
    --sf-grid-gap-desk: {{ section.settings.grid_gap_desktop }}px;
  }
</style>
<footer class="site-footer">
  <div class="site-footer__container">
    {% if section.blocks.size > 0 %}
      <div class="site-footer__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              <div class="site-footer__block site-footer__block--menu" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.menu != blank %}
                  <ul class="site-footer__menu-list">
                    {% for link in block.settings.menu.links %}
                      {% liquid
                        assign highlight = false
                        if forloop.last and block.settings.highlight_last_item
                          assign highlight = true
                        endif
                      %}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="site-footer__menu-link{% if highlight %} site-footer__menu-link--highlight{% endif %}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% elsif request.design_mode %}
                  <p class="site-footer__text">Select a menu in the theme editor.</p>
                {% endif %}
              </div>

            {% when 'text' %}
              <div class="site-footer__block site-footer__block--text" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.content != blank %}
                  <div class="site-footer__text">{{ block.settings.content }}</div>
                {% endif %}
                {% if block.settings.show_social_icons and social_links != blank %}
                  <ul class="site-footer__social-list">
                    {% if section.settings.social_facebook != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_facebook }}"
                          aria-label="Facebook"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.25-1.5 1.5-1.5H16.5V4.3C16.1 4.25 15 4.15 13.7 4.15c-2.7 0-4.5 1.65-4.5 4.65V10.5H6.7v3H9.2V21h4.3Z"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                    {% if section.settings.social_instagram != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_instagram }}"
                          aria-label="Instagram"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            aria-hidden="true"
                          >
                            <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                    {% if section.settings.social_whatsapp != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_whatsapp }}"
                          aria-label="WhatsApp"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3Zm0 16.3a7.3 7.3 0 0 1-3.7-1l-.3-.2-2.7.7.7-2.6-.2-.3A7.3 7.3 0 1 1 12 19.3Zm4-5.4c-.2-.1-1.3-.7-1.5-.7-.2-.1-.4-.1-.5.1-.2.2-.6.7-.7.9-.1.1-.3.2-.5.1-1.3-.6-2.1-1.1-3-2.5-.2-.3.2-.3.5-.9.1-.1.1-.3 0-.4-.1-.1-.5-1.3-.7-1.7-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9 0 1.1.8 2.2.9 2.3.1.2 1.6 2.5 4 3.4.6.2 1 .4 1.3.5.5.2 1 .1 1.4-.1.4-.2 1.3-.5 1.5-1 .2-.5.2-.9.1-1Z"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                    {% if section.settings.social_x != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_x }}"
                          aria-label="X (Twitter)"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="m4 4 7 8.5L4.4 20H6l6-6.9L16.5 20H20l-7.4-8.9L19.8 4h-1.6L12.5 10 8 4H4Z"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                    {% if section.settings.social_tiktok != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_tiktok }}"
                          aria-label="TikTok"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M16.5 3c.4 2 1.8 3.4 3.8 3.6v2.6c-1.4 0-2.7-.4-3.8-1.2v6.4a5.3 5.3 0 1 1-4.6-5.3v2.7a2.6 2.6 0 1 0 1.9 2.6V3h2.7Z"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                    {% if section.settings.social_youtube != blank %}
                      <li>
                        <a
                          class="site-footer__social-link"
                          href="{{ section.settings.social_youtube }}"
                          aria-label="YouTube"
                        >
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M21.5 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.5.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .5 4.8 2.8 2.8 0 0 0 2 2c1.7.5 7.5.5 7.5.5s5.8 0 7.5-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-4.8 29 29 0 0 0-.5-4.8ZM10 15V9l5.2 3-5.2 3Z"/>
                          </svg>
                        </a>
                      </li>
                    {% endif %}
                  </ul>
                {% endif %}
              </div>

            {% when 'image' %}
              {% liquid
                assign img_width = block.settings.width
                assign img_src_width = img_width | times: 2
              %}
              <div class="site-footer__block site-footer__block--image" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.image %}
                  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                  {{
                    block.settings.image
                    | image_url: width: img_src_width
                    | image_tag: width: img_width, loading: 'lazy', class: 'site-footer__image', alt: block.settings.alt
                    | default: block.settings.image.alt
                  }}
                  {% if block.settings.link != blank %}</a>{% endif %}
                {% endif %}
              </div>

            {% when 'newsletter' %}
              {% liquid
                assign newsletter_form_id = 'FooterNewsletterForm-' | append: block.id
              %}
              <div class="site-footer__block site-footer__block--newsletter" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
                {% endif %}

                {% form 'customer', id: newsletter_form_id, class: 'newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  {% if form.posted_successfully? %}
                    <p class="newsletter-form__success" role="status">Thanks for subscribing!</p>
                  {% else %}
                    {% if block.settings.subheading != blank %}
                      <p class="newsletter-form__intro">{{ block.settings.subheading }}</p>
                    {% endif %}

                    {% if form.errors %}
                      <p class="newsletter-form__error" role="alert">
                        {% for field in form.errors %}
                          {{ form.errors.messages[field] }}
                        {% endfor %}
                      </p>
                    {% endif %}

                    {% if block.settings.show_first_name %}
                      <div class="newsletter-form__field">
                        <label class="visually-hidden" for="NewsletterFirstName-{{ block.id }}">First name</label>
                        <input
                          type="text"
                          id="NewsletterFirstName-{{ block.id }}"
                          name="contact[first_name]"
                          placeholder="First Name"
                          autocomplete="given-name"
                        >
                      </div>
                    {% endif %}

                    <div class="newsletter-form__field">
                      <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">Email address</label>
                      <input
                        type="email"
                        id="NewsletterEmail-{{ block.id }}"
                        name="contact[email]"
                        placeholder="Your Email Address"
                        autocomplete="email"
                        required
                        value="{{ customer.email }}"
                      >
                    </div>

                    {% if block.settings.consent_text != blank %}
                      <p class="newsletter-form__consent-note">{{ block.settings.consent_text }}</p>
                    {% endif %}

                    {% if block.settings.checkbox_label != blank %}
                      <label class="newsletter-form__checkbox">
                        <input type="checkbox" name="opt_in" value="yes" required>
                        <span>{{ block.settings.checkbox_label }}</span>
                      </label>
                    {% endif %}

                    <button type="submit" class="newsletter-form__submit">
                      {{ block.settings.button_label }}
                    </button>
                  {% endif %}
                {% endform %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="site-footer__bottom">
      <div class="site-footer__bottom-left">
        {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
          {% form 'localization', id: 'FooterLanguageForm', class: 'localization-form' %}
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <div class="localization-form__select-wrap">
              <select
                class="localization-form__select_it"
                name="locale_code"
                aria-label="Language"
                onchange="this.form.submit()"
              >
                {% for language in localization.available_languages %}
                  <option
                    value="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endform %}
        {% endif %}

        {% if section.settings.show_currency_selector and localization.available_countries.size > 1 %}
          {% form 'localization', id: 'FooterCurrencyForm', class: 'localization-form' %}
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <div class="localization-form__select-wrap">
              <select
                class="localization-form__select"
                name="country_code"
                aria-label="Currency"
                onchange="this.form.submit()"
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </option>
                {% endfor %}
              </select>
              <svg class="localization-form__chevron" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {% endform %}
        {% endif %}

        {% liquid
          assign copyright_year = 'now' | date: '%Y'
          assign auto_copyright = '© ' | append: copyright_year | append: ' ' | append: shop.name
        %}
        <span class="site-footer__copyright">
          {{ section.settings.copyright_override | default: auto_copyright }}
        </span>
      </div>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="site-footer__payments">
          {% if section.settings.payment_icons_label != blank %}
            <span class="site-footer__payments-label">{{ section.settings.payment_icons_label }}</span>
          {% endif %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "Only appears if your store has more than one language published",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show currency selector",
      "info": "Only appears if your store has more than one market/currency enabled",
      "default": true
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show accepted payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_icons_label",
      "label": "Label",
      "default": "We accept"
    },

    {
      "type": "header",
      "content": "Mobile settings (< 750px)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Block heading font size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Body text font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid row gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Tablet settings (750px – 989px)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_size_tablet",
      "label": "Block heading font size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_font_size_tablet",
      "label": "Body text font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "grid_gap_tablet",
      "label": "Grid row gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Desktop settings (≥ 990px)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Block heading font size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_font_size_desktop",
      "label": "Body text font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "menu_link_font_size_desktop",
      "label": "Menu link font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "copyright_font_size_desktop",
      "label": "Copyright font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "label": "Grid row gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Global settings"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (button, highlighted link)",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#4A5568"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#4A5568"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ECECEA"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider line",
      "default": "#D9D9D6"
    },
      {
      "type": "range",
      "id": "menu_link_font_size",
      "label": "Menu link font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
      {
      "type": "range",
      "id": "copyright_font_size",
      "label": "Copyright font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "text",
      "id": "copyright_override",
      "label": "Custom copyright text (optional)",
      "info": "Leave blank to auto-generate \u00a9 [year] [store name]"
    },
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
