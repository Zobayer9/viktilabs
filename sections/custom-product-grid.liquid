{{ 'section-main-collection-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign banner_interval = section.settings.banner_interval
  assign banner_blocks = section.blocks | where: 'type', 'banner'
  assign banner_total = banner_blocks.size
  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif
  assign show_sort = false
  if section.settings.enable_sorting and collection.sort_options.size > 0
    assign show_sort = true
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by
-%}

<section
  class="product-grid-section"
  id="ProductGridSection-{{ section.id }}"
  style="
    --desktop-columns: {{ section.settings.columns_desktop }};
    --tablet-columns: {{ section.settings.columns_tablet }};
    --mobile-columns: {{ section.settings.columns_mobile }};
    --grid-card-radius: {{ section.settings.card_border_radius }}px;
  "
>
  <style>
    #ProductGridSection-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top_mobile }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      --section-font-size-scale: {{ section.settings.font_size_scale_mobile }};
      --color-accent: {{ section.settings.color_accent }};
      --color-accent-text: {{ section.settings.color_accent_text }};
      --color-text-primary: {{ section.settings.color_text_primary }};
      --color-sale: {{ section.settings.color_sale }};
      --color-success: {{ section.settings.color_success }};
      --color-badge-bestseller: {{ section.settings.color_badge_bestseller }};
      --color-badge-new: {{ section.settings.color_badge_new }};
      --section-background: {{ section.settings.background_color }};
    }

    @media (min-width: 750px) {
      #ProductGridSection-{{ section.id }} {
        --section-padding-top: {{ section.settings.padding_top_tablet }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
        --section-font-size-scale: {{ section.settings.font_size_scale_tablet }};
      }
    }

    @media (min-width: 990px) {
      #ProductGridSection-{{ section.id }} {
        --section-padding-top: {{ section.settings.padding_top_desktop }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        --section-font-size-scale: {{ section.settings.font_size_scale_desktop }};
      }
    }
  </style>

  <div class="product-grid-section__inner page-width">
    {%- paginate collection.products by products_per_page -%}
      {%- assign range_start = paginate.current_offset | plus: 1 -%}
      {%- assign range_end = paginate.current_offset | plus: collection.products.size -%}

      <div class="product-grid-toolbar">
        {%- if show_filters -%}
          <filter-drawer class="product-grid-toolbar__filters">
            <button
              type="button"
              class="product-grid-toolbar__filters-toggle"
              aria-haspopup="dialog"
              aria-controls="FiltersDrawer-{{ section.id }}"
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                <path d="M2 5h14M5 9h8M7.5 13h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              Show filters
            </button>

            <dialog id="FiltersDrawer-{{ section.id }}" class="product-grid-filters" aria-label="Filters">
              <form id="FacetFilterForm-{{ section.id }}" method="get" action="{{ collection.url }}">
                <div class="product-grid-filters__header">
                  <h2 class="product-grid-filters__title">Filters</h2>
                  <button type="button" class="product-grid-filters__close" aria-label="Close filters">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                      <path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>

                <div class="product-grid-filters__body">
                  {%- for filter in collection.filters -%}
                    <details class="product-grid-filters__group" open>
                      <summary class="product-grid-filters__group-label">
                        {{ filter.label }}
                        <span class="product-grid-filters__group-icon" aria-hidden="true"></span>
                      </summary>

                      <div class="product-grid-filters__group-content">
                        {%- if filter.type == 'price_range' -%}
                          <div class="product-grid-filters__price-range">
                            <label class="visually-hidden" for="FilterPriceMin-{{ section.id }}">Minimum price</label>
                            <input
                              type="number"
                              id="FilterPriceMin-{{ section.id }}"
                              name="{{ filter.min_value.param_name }}"
                              value="{{ filter.min_value.value }}"
                              placeholder="Min"
                              min="0"
                              inputmode="numeric"
                              pattern="[0-9]*"
                            >
                            <span aria-hidden="true">–</span>
                            <label class="visually-hidden" for="FilterPriceMax-{{ section.id }}">Maximum price</label>
                            <input
                              type="number"
                              id="FilterPriceMax-{{ section.id }}"
                              name="{{ filter.max_value.param_name }}"
                              value="{{ filter.max_value.value }}"
                              placeholder="Max"
                              min="0"
                              inputmode="numeric"
                              pattern="[0-9]*"
                            >
                          </div>
                        {%- else -%}
                          <ul class="product-grid-filters__list" role="list">
                            {%- for value in filter.values -%}
                              {%- unless value.count == 0 and value.active == false -%}
                                <li class="product-grid-filters__list-item">
                                  <label>
                                    <input
                                      type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      {% if value.active %}
                                        checked
                                      {% endif %}
                                      {% if value.count == 0 and value.active == false %}
                                        disabled
                                      {% endif %}
                                    >
                                    <span class="product-grid-filters__checkbox" aria-hidden="true"></span>
                                    <span>{{ value.label }}</span>
                                    <span class="product-grid-filters__count" aria-hidden="true"
                                      >({{ value.count }})</span
                                    >
                                  </label>
                                </li>
                              {%- endunless -%}
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    </details>
                  {%- endfor -%}
                </div>

                <div class="product-grid-filters__footer">
                  {%- if collection.filters.size > 0 -%}
                    <a href="{{ collection.url }}" class="product-grid-filters__clear">Clear all</a>
                  {%- endif -%}
                  <button type="submit" class="product-grid-filters__submit">View results</button>
                </div>
              </form>
            </dialog>
          </filter-drawer>
        {%- endif -%}

        {%- if section.settings.show_product_count -%}
          <p class="product-grid-toolbar__count" aria-live="polite">
            {%- if paginate.items > 0 -%}
              Showing {{ range_start }}–{{ range_end }} of {{ paginate.items }} products
            {%- else -%}
              No products found
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if show_sort -%}
          <div class="product-grid-toolbar__sort">
            <label for="SortBy-{{ section.id }}" class="visually-hidden">Sort by</label>
            <select
              name="sort_by"
              id="SortBy-{{ section.id }}"
              form="FacetFilterForm-{{ section.id }}"
              class="product-grid-toolbar__sort-select"
            >
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == current_sort %}
                    selected
                  {% endif %}
                >
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- if collection.products.size == 0 -%}
        <div class="product-grid-empty">
          <p>No products match your selection.</p>
          {%- if collection.filters.size > 0 -%}
            <a href="{{ collection.url }}" class="product-grid-filters__clear">Clear filters</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <ul class="product-grid" id="ProductGridList-{{ section.id }}" role="list">
          {%- for product in collection.products -%}
            <li class="product-grid__item" id="ProductGridItem-{{ product.id }}">
              {% if forloop.index > 4 %}
                {% assign lazy = true %}
              {% else %}
                {% assign lazy = false %}
              {% endif %}
              {% render 'product-grid-card', product: product, lazy: lazy %}
            </li>
            {%- if banner_total > 0 and banner_interval > 0 and forloop.index == banner_interval -%}
              {%- assign banner_block = banner_blocks.first -%}

              <li class="product-grid__item product-grid__item--banner" {{ banner_block.shopify_attributes }}>
                {%- render 'product-grid-banner', block: banner_block -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div id="ProductGridLiveRegion-{{ section.id }}" class="visually-hidden" aria-live="polite"></div>

        {%- if paginate.pages > 1 -%}
          {%- if section.settings.pagination_type == 'load_more' -%}
            <load-more-products
              id="ProductGridPagination-{{ section.id }}"
              class="product-grid-load-more"
              data-list-id="ProductGridList-{{ section.id }}"
              data-pagination-id="ProductGridPagination-{{ section.id }}"
              data-live-region-id="ProductGridLiveRegion-{{ section.id }}"
            >
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </load-more-products>
          {%- else -%}
            <nav class="product-grid-pagination" role="navigation" aria-label="Pagination">
              <ul class="product-grid-pagination__list">
                {%- if paginate.previous -%}
                  <li>
                    <a
                      href="{{ paginate.previous.url }}"
                      class="product-grid-pagination__link"
                      aria-label="Previous page"
                    >
                      Prev
                    </a>
                  </li>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" class="product-grid-pagination__link" aria-label="Page {{ part.title }}">
                        {{ part.title }}
                      </a>
                    {%- elsif part.title == paginate.current_page -%}
                      <span
                        class="product-grid-pagination__link product-grid-pagination__link--current"
                        aria-current="page"
                      >
                        {{ part.title }}
                      </span>
                    {%- else -%}
                      <span class="product-grid-pagination__ellipsis">{{ part.title }}</span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" class="product-grid-pagination__link" aria-label="Next page">
                      Next
                    </a>
                  </li>
                {%- endif -%}
              </ul>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<script src="{{ 'section-main-collection-product-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Vikti Product grid",
  "tag": "section",
  "class": "section section-product-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "banner_interval",
      "label": "Insert banner after every N products",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Filtering, sorting & count"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination style",
      "options": [
        { "value": "pagination", "label": "Pagination" },
        { "value": "load_more", "label": "Load more button" }
      ],
      "default": "load_more"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent color",
      "default": "#F7B558"
    },
    {
      "type": "color",
      "id": "color_accent_text",
      "label": "Accent text color",
      "default": "#1E1E1E"
    },
    {
      "type": "color",
      "id": "color_text_primary",
      "label": "Text color",
      "default": "#1E1E1E"
    },
    {
      "type": "color",
      "id": "color_sale",
      "label": "Sale color",
      "default": "#C43C32"
    },
    {
      "type": "color",
      "id": "color_success",
      "label": "Success color",
      "default": "#508C5A"
    },
    {
      "type": "color",
      "id": "color_badge_bestseller",
      "label": "Bestseller badge color",
      "default": "#E0A03C"
    },
    {
      "type": "color",
      "id": "color_badge_new",
      "label": "New badge color",
      "default": "#96B46E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "Top padding tablet",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "Bottom padding tablet",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_scale_mobile",
      "label": "Font size scale mobile",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1.0
    },
    {
      "type": "range",
      "id": "font_size_scale_tablet",
      "label": "Font size scale tablet",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1.0
    },
    {
      "type": "range",
      "id": "font_size_scale_desktop",
      "label": "Font size scale desktop",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1.0
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Collection banner",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "info": "On mobile, image always appears above content.",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ],
          "default": "right"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your personal health bundle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Create your own custom bundle and unlock exclusive benefits.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build your bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#E9EFE3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vikti Product grid"
    }
  ]
}
{% endschema %}