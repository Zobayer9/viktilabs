{{ 'custom-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign radius = section.settings.border_radius
  assign show_arrows = section.settings.enable_arrows
  assign block_count = section.blocks.size
-%}

<style>
  #CollectionList-{{ section.id }} {
    --columns-desktop: {{ columns_desktop }};
    --columns-mobile: {{ columns_mobile }};
    --card-radius: {{ radius }}px;

    /* Mobile */
    --cl-pt: {{ section.settings.padding_top_mobile }}px;
    --cl-pb: {{ section.settings.padding_bottom_mobile }}px;
    --cl-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --cl-title-size: {{ section.settings.title_font_size_mobile }}px;
    --cl-gap: {{ section.settings.card_gap_mobile }}px;
    --cl-bg: {{ section.settings.bg_color_mobile }};
    --cl-heading-color: {{ section.settings.heading_color_mobile }};
    --cl-title-color: {{ section.settings.title_color_mobile }};
    --cl-heading-align: {{ section.settings.heading_align_mobile }};

    /* Tablet */
    --cl-pt-tab: {{ section.settings.padding_top_tablet }}px;
    --cl-pb-tab: {{ section.settings.padding_bottom_tablet }}px;
    --cl-heading-size-tab: {{ section.settings.heading_font_size_tablet }}px;
    --cl-title-size-tab: {{ section.settings.title_font_size_tablet }}px;
    --cl-gap-tab: {{ section.settings.card_gap_tablet }}px;
    --cl-bg-tab: {{ section.settings.bg_color_tablet }};
    --cl-heading-color-tab: {{ section.settings.heading_color_tablet }};
    --cl-title-color-tab: {{ section.settings.title_color_tablet }};
    --cl-heading-align-tab: {{ section.settings.heading_align_tablet }};

    /* Desktop */
    --cl-pt-desk: {{ section.settings.padding_top_desktop }}px;
    --cl-pb-desk: {{ section.settings.padding_bottom_desktop }}px;
    --cl-heading-size-desk: {{ section.settings.heading_font_size_desktop }}px;
    --cl-title-size-desk: {{ section.settings.title_font_size_desktop }}px;
    --cl-gap-desk: {{ section.settings.card_gap_desktop }}px;
    --cl-bg-desk: {{ section.settings.bg_color_desktop }};
    --cl-heading-color-desk: {{ section.settings.heading_color_desktop }};
    --cl-title-color-desk: {{ section.settings.title_color_desktop }};
    --cl-heading-align-desk: {{ section.settings.heading_align_desktop }};

  }
</style>

<section
  id="CollectionList-{{ section.id }}"
  class="collection-list-section{% if section.settings.hide_mobile %} collection-list-section--hide-mobile{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="collection-list-section__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <collection-list-carousel
        class="collection-list-carousel"
        data-show-arrows="{{ show_arrows }}"
      >
        <div class="collection-list-carousel__viewport">
          <ul
            class="collection-list"
            role="list"
            id="CollectionList-Track-{{ section.id }}"
          >
            {%- for block in section.blocks -%}
              {%- assign collection = block.settings.collection -%}
              {%- assign card_image = block.settings.image | default: collection.featured_image -%}
              {%- if forloop.first -%}
                {%- assign img_loading = 'eager' -%}
                {%- assign img_fetchpriority = 'high' -%}
              {%- else -%}
                {%- assign img_loading = 'lazy' -%}
                {%- assign img_fetchpriority = 'auto' -%}
              {%- endif -%}
              {%- capture card_image_markup -%}
                {%- if block.settings.show_image -%}
                  <div class="collection-list__image-wrapper">
                    {%- if card_image -%}
                      {{
                        card_image
                        | image_url: width: 700
                        | image_tag:
                          loading: img_loading,
                          fetchpriority: img_fetchpriority,
                          widths: '275, 550, 700, 1100',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                          alt: collection.title,
                          class: 'collection-list__image'
                      }}
                    {%- else -%}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'collection-list__image collection-list__image--placeholder' }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endcapture -%}
              <li class="collection-list__item" {{ block.shopify_attributes }}>
                {%- if collection != blank -%}
                  <a
                    href="{{ collection.url }}"
                    class="collection-list__card"
                    aria-label="{{ collection.title | escape }}"
                  >
                    {{ card_image_markup }}
                    <h3 class="collection-list__title">{{ collection.title }}</h3>
                  </a>
                {%- else -%}
                  <div class="collection-list__card collection-list__card--empty">
                    {{ card_image_markup }}
                    <h3 class="collection-list__title">
                      {{ block.settings.collection_title | default: collection.title }}
                    </h3>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if show_arrows -%}
          <div class="collection-list-carousel__nav" hidden>
            <button
              type="button"
              class="collection-list-carousel__button collection-list-carousel__button--prev"
              data-direction="prev"
              aria-label="{{ 'general.slider.previous_slide' | t: default: 'Previous collections' }}"
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                <path d="M11 3.5 5.5 9l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="collection-list-carousel__button collection-list-carousel__button--next"
              data-direction="next"
              aria-label="{{ 'general.slider.next_slide' | t: default: 'Next collections' }}"
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                <path d="M7 3.5 12.5 9 7 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </collection-list-carousel>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'custom-collection-list.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "vikti collection list",
  "tag": "section",
  "class": "section section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show next/previous buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide this section on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile settings (< 750px)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Card title font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Gap between cards",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color_mobile",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color_mobile",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "title_color_mobile",
      "label": "Card title color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
