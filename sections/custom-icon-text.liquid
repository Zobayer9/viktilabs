{{ 'section-icon-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .icon-columns {
    --ic-bg: {{ section.settings.bg_color }};
    --ic-text: {{ section.settings.text_color }};
    --ic-icon-width: {{ section.settings.icon_width }}px;
    --ic-icon-height: {{ section.settings.icon_height }}px;
    --ic-columns-mobile: {{ section.settings.columns_mobile }};
    --ic-column-gap: {{ section.settings.column_gap_mobile }}px;
    --ic-row-gap: {{ section.settings.row_gap_mobile }}px;
    --ic-pt: {{ section.settings.padding_top_mobile }}px;
    --ic-pb: {{ section.settings.padding_bottom_mobile }}px;
    --ic-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --ic-label-size: {{ section.settings.label_font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .icon-columns {
      --ic-columns-tablet: {{ section.settings.columns_tablet }};
      --ic-column-gap: {{ section.settings.column_gap_tablet }}px;
      --ic-row-gap: {{ section.settings.row_gap_tablet }}px;
      --ic-pt: {{ section.settings.padding_top_tablet }}px;
      --ic-pb: {{ section.settings.padding_bottom_tablet }}px;
      --ic-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --ic-label-size: {{ section.settings.label_font_size_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .icon-columns {
      --ic-columns-desktop: {{ section.settings.columns_desktop }};
      --ic-column-gap: {{ section.settings.column_gap_desktop }}px;
      --ic-row-gap: {{ section.settings.row_gap_desktop }}px;
      --ic-pt: {{ section.settings.padding_top_desktop }}px;
      --ic-pb: {{ section.settings.padding_bottom_desktop }}px;
      --ic-heading-size: {{ section.settings.heading_font_size_desktop }}px;
      --ic-label-size: {{ section.settings.label_font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<section
  class="icon-columns"
>
  <div class="icon-columns__container">
    {% if section.settings.heading != blank %}
      <h2 class="icon-columns__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="icon-columns__grid">
        {% for block in section.blocks %}
          {% liquid
            assign icon = block.settings.icon
            assign label = block.settings.label
            assign link = block.settings.link
          %}
          {% capture item_inner %}
            <span class="icon-columns__icon-wrap">
              {% if icon %}
                {{
                  icon
                  | image_url: width: 320
                  | image_tag:
                    widths: '64, 128, 192, 320',
                    loading: 'lazy',
                    width: section.settings.icon_width,
                    height: section.settings.icon_height,
                    class: 'icon-columns__icon',
                    alt: ''
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'icon-columns__icon icon-columns__icon--placeholder' }}
              {% endif %}
            </span>
            {% if label != blank %}
              <span class="icon-columns__label">{{ label }}</span>
            {% endif %}
          {% endcapture %}

          <li class="icon-columns__item" {{ block.shopify_attributes }}>
            {% if link != blank %}
              <a href="{{ link | escape }}" class="icon-columns__link">{{ item_inner }}</a>
            {% else %}
              <div class="icon-columns__block">{{ item_inner }}</div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p class="icon-columns__heading">Add an "Icon" block to get started.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Icon with text",
  "tag": "section",
  "class": "section-icon-columns-wrapper",
  "max_blocks": 12,
  "settings": [
