    },
    {
      "type": "color",
      "id": "disadvantage_heading_color",
      "label": "Heading",
      "default": "#9A9A9A"
    },
    {
      "type": "color",
      "id": "disadvantage_text_color",
      "label": "Row text",
      "default": "#4A5568"
    },
    {
      "type": "color",
      "id": "disadvantage_icon_bg",
      "label": "Icon background",
      "default": "#1A1A1A"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "benefit_text",
          "label": "Benefit text",
          "default": "Scientific development in Germany"
        },
        {
          "type": "text",
          "id": "disadvantage_text",
          "label": "Disadvantage text",
          "default": "Often exact copies of overseas formulas"
        },
  
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit comparison",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "benefit_text": "Scientific development in Germany",
            "disadvantage_text": "Often exact copies of overseas formulas"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "benefit_text": "Manufacturing & bottling in Germany & the EU",
            "disadvantage_text": "Manufactured in the Far East or third countries"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "benefit_text": "Maximum transparency regarding ingredients",
            "disadvantage_text": "Partially hidden, undeclared additives"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "benefit_text": "Non-GMO (in accordance with EU regulations)",
