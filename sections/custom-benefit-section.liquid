      "label": "padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_tablet",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "desc_font_size_tablet",
      "label": "Description font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "col_heading_font_size_tablet",
      "label": "Column heading font size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "row_font_size_tablet",
      "label": "Row text font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Desktop settings (≥ 990px)"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading font size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desc_font_size_desktop",
      "label": "Description font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "col_heading_font_size_desktop",
      "label": "Column heading font size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "row_font_size_desktop",
      "label": "Row text font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Benefit column colors"
    },
    {
      "type": "color",
      "id": "benefit_heading_color",
      "label": "Heading",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "benefit_text_color",
      "label": "Row text",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "benefit_icon_bg",
      "label": "Icon background",
      "default": "#4A5D3A"
    },
    {
      "type": "header",
